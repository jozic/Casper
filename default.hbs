<!DOCTYPE html>
<html>
<head>
    {{!-- Document Settings --}}
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    {{!-- Page Meta --}}
    <title>{{meta_title}}</title>

    {{!-- Mobile Meta --}}
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {{!-- Styles'n'Scripts --}}
    <link rel="stylesheet" type="text/css" href="{{asset "css/fonts.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />

    <style>
        .tags-loader {
          border: 4px solid #f3f3f3;
          border-top: 4px solid #3498db;
          border-radius: 50%;
          width: 40px;
          height: 40px;
          animation: spin 1s linear infinite;
          margin: 50px auto;
        }
        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
    </style>

    {{!-- Ghost outputs important style and meta data with this tag --}}
    {{ghost_head}}
</head>
<body class="{{body_class}} nav-closed">

    {{!-- The blog navigation links --}}
    {{navigation}}
    

    <div class="site-wrapper">

    <div class="top-bar">
      <span class="go-home">
          <a href="{{@site.url}}">{{@site.title}}</a>
      </span>
      <div id="site-search" class="site-search">
        <input class="typeahead" type="text" placeholder="Search bars by name...">
      </div>
   </div>
        {{!-- All the main content gets inserted here, index.hbs, post.hbs, etc --}}
        {{{body}}}

        {{!-- The tiny footer at the very bottom --}}
        <footer class="site-footer clearfix">
            <section class="copyright"><a href="{{@site.url}}">{{@site.title}}</a> &copy; 2016-{{date format="YYYY"}}</section>
            <section class="poweredby">Proudly published with <a href="https://ghost.org">Ghost</a></section>
        </footer>

    </div>

    {{!-- Ghost outputs important scripts and data with this tag --}}
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/@tryghost/content-api@latest/umd/content-api.min.js"></script>
    {{ghost_foot}}
    {{!-- Fitvids makes video embeds responsive and awesome --}}
    <script type="text/javascript" src="{{asset "js/jquery.fitvids.js"}}"></script>
    {{!-- The main JavaScript file for Casper --}}
    <script type="text/javascript" src="{{asset "js/index.js"}}"></script>
    <script type="text/javascript" src="{{asset "js/typeahead.bundle.min.js"}}"></script>

    <script>
    $(document).ready(function() {
        const api = new GhostContentAPI({
            url: '{{@site.url}}',
            key: 'GHOST_API_KEY_PLACEHOLDER',
            version: "v5.0"
        });
        const siteUrl = "{{@site.url}}";

        // --- Title-only Search ---
        if (!$('body').hasClass('page-tags')) {
            async function fetchAllPostsForSearch() {
                let allPosts = [];
                let page = 1;
                let response;
                try {
                    do {
                        response = await api.posts.browse({ limit: 50, page: page, fields: "slug,title" });
                        allPosts = allPosts.concat(response);
                        page++;
                    } while (response.meta.pagination.next);
                } catch (error) {
                    console.error("[Search] Error fetching posts:", error);
                }
                return allPosts;
            }

            fetchAllPostsForSearch().then((posts) => {
                var postsHound = new Bloodhound({
                    datumTokenizer: Bloodhound.tokenizers.obj.whitespace('title'),
                    queryTokenizer: Bloodhound.tokenizers.whitespace,
                    local: posts
                });

                $('#site-search .typeahead').typeahead({
                    hint: true, highlight: true, minLength: 1
                }, {
                    name: 'posts', source: postsHound, display: 'title', limit: 10,
                    templates: {
                        suggestion: function(data) {
                            return '<p><strong><a href="'+ siteUrl +'/'+ data.slug + '">' + data.title + '</a></strong></p>';
                        }
                    }
                });
                $('#site-search').show();
            }).catch((err) => { console.error("[Search] Error initializing:", err); });
        }
        
        // --- All Tags on One Page Implementation ---
        if ($('body').hasClass('page-tags')) {
            async function fetchAllTagsWithCounts() {
                let allTags = [];
                let page = 1;
                let response;
                try {
                    do {
                        response = await api.tags.browse({
                            limit: 50,
                            page: page,
                            include: 'count.posts',
                            order: 'count.posts desc'
                        });
                        if (response && Array.isArray(response)) {
                            const publicTags = response.filter(tag => !tag.name.startsWith('#'));
                            allTags = allTags.concat(publicTags);
                        } else {
                            break; 
                        }
                        page++;
                    } while (response && response.meta && response.meta.pagination && response.meta.pagination.next);
                } catch (error) {
                    console.error("[Tags Page] Error during API call for tags:", error);
                }
                return allTags;
            }

            fetchAllTagsWithCounts().then((tags) => {
                const container = $('#all-tags-container');
                container.empty(); // Remove the loader

                if (container.length === 0) { return; }
                if (!tags || tags.length === 0) {
                    container.append('<p>No tags found.</p>');
                    return;
                }

                tags.forEach(tag => {
                    const postCount = (tag.count && tag.count.posts) ? tag.count.posts : 0;
                    const tagHtml = `
                        <a href="${siteUrl}/tag/${tag.slug}">
                        <h2>${tag.name} <small>(${postCount})</small></h2>
                        </a>
                    `;
                    container.append(tagHtml);
                });
            }).catch((err) => { 
                $('#all-tags-container').empty().append('<p>Error loading tags.</p>');
                console.error("[Tags Page] Error rendering tags:", err); 
            });
        }
    });
    </script>
    <script>
      var links = document.querySelectorAll('.post-content a');  
      for (var i = 0, length = links.length; i < length; i++) {  
        if (links[i].hostname != window.location.hostname) {
          links[i].target = '_blank';
        }
      }
    </script>
</body>
</html>
